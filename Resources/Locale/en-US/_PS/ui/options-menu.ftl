ui-options-bloom = Bloom:
ui-options-bloom-tooltip = Adds a soft bloom: lights glow and the image softens as the value rises. 0% disables it.
ui-options-lobby-menu-transparent = Transparent lobby menu
ui-options-lobby-menu-transparent-tooltip = Makes the main lobby menu translucent so the background shows through.
ui-options-lobby-menu-blur = Blur lobby menu background
ui-options-lobby-menu-blur-tooltip = Blurs the lobby background behind the main menu. Requires the Transparent lobby menu option.
