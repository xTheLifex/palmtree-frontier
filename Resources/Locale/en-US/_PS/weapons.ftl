ammo-fill-random = Insert randomly
ammo-fill-sequence = Fill sequence
ammo-fill-random-emote = haphazardly shoves { $count ->
    [one] a shell
    *[other] { $count } shells
} into {THE($gun)}.
ammo-fill-sequence-emote = methodically slots { $count ->
    [one] a shell
    *[other] { $count } shells
} into {THE($gun)}.
ammo-shoot-self = Shoot self
ammo-shoot-self-empty = The gun is empty.
ammo-shoot-self-emote = presses {THE($gun)} against themselves and fires {THE($shell)}.
ammo-shoot-self-unknown-shell = unknown shell
