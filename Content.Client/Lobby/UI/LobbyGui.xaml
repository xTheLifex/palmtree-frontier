<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maths="clr-namespace:Robust.Shared.Maths;assembly=Robust.Shared.Maths"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:psLobby="clr-namespace:Content.Client._PS.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets">
    <!-- Background -->
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" />
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="BackgroundFade"
                 Stretch="KeepAspectCovered" />

    <LayoutContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Margin="20">
        <!-- Centered main menu -->
        <psLobby:LobbyMenuBackdropPanel Name="MainMenuPanel"
                                        StyleClasses="AngleRect"
                                        MinSize="600 0"
                                        MaxSize="680 640"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
                <info:LinkBanner Name="LinkBanner"
                                 VerticalExpand="False"
                                 HorizontalAlignment="Center"
                                 Margin="3" />

                <Label Name="ServerName"
                       Access="Public"
                       StyleClasses="LabelHeadingBigger"
                       HorizontalAlignment="Center" />
                <Label Name="StartTime"
                       Access="Public"
                       HorizontalAlignment="Center"
                       StyleClasses="LabelBig" />
                <Label Name="StationTime"
                       Access="Public"
                       HorizontalAlignment="Center"
                       FontColorOverride="{x:Static maths:Color.LightGray}" />

                <controls:HLine Color="{x:Static style:StyleNano.NanoGold}" Thickness="2" />
                <BoxContainer Name="VoteContainer"
                              Access="Public"
                              Orientation="Vertical"
                              SeparationOverride="4"
                              HorizontalAlignment="Center" />

                <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" />

                <controls:HLine Color="{x:Static style:StyleNano.NanoGold}" Thickness="2" />

                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                    <BoxContainer Orientation="Horizontal"
                                  HorizontalExpand="True"
                                  SeparationOverride="6">
                        <TextureRect Name="ReadyStatusIcon"
                                     Access="Public"
                                     TexturePath="/Textures/Interface/Nano/cross.svg.png"
                                     TextureScale="1.2 1.2"
                                     VerticalAlignment="Center"
                                     ModulateSelfOverride="#C05252" />
                        <Button Name="ReadyButton"
                                Access="Public"
                                ToggleMode="True"
                                Text="{Loc 'ui-lobby-ready-up-button'}"
                                StyleClasses="ButtonBig"
                                HorizontalExpand="True"
                                MinHeight="44" />
                    </BoxContainer>
                    <cc:UICommandButton Command="observe"
                                        Name="ObserveButton"
                                        Access="Public"
                                        Text="{Loc 'ui-lobby-observe-button'}"
                                        StyleClasses="ButtonBig"
                                        MinHeight="44"
                                        WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                </BoxContainer>

                <BoxContainer Orientation="Horizontal"
                              HorizontalExpand="True"
                              HorizontalAlignment="Center"
                              SeparationOverride="4">
                    <Button Name="AHelpButton"
                            Access="Public"
                            Text="{Loc 'ui-lobby-ahelp-button'}"
                            StyleClasses="ButtonBig" />
                    <vote:VoteCallMenuButton Name="CallVoteButton" StyleClasses="ButtonBig" />
                    <Button Name="OptionsButton"
                            Access="Public"
                            StyleClasses="ButtonBig"
                            Text="{Loc 'ui-lobby-options-button'}" />
                    <Button Name="LeaveButton"
                            Access="Public"
                            StyleClasses="ButtonBig"
                            Text="{Loc 'ui-lobby-leave-button'}" />
                </BoxContainer>

                <RichTextLabel Name="PlaytimeComment"
                               Access="Public"
                               Visible="False"
                               HorizontalAlignment="Center" />

                <BoxContainer Orientation="Horizontal"
                              HorizontalAlignment="Center"
                              SeparationOverride="4">
                    <info:DevInfoBanner Name="DevInfoBanner" VerticalExpand="False" Margin="3" />
                    <PanelContainer StyleClasses="AngleRect">
                        <RichTextLabel Name="LobbySong" Access="Public" HorizontalAlignment="Center" />
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
        </psLobby:LobbyMenuBackdropPanel>

        <!-- Centered character setup -->
        <PanelContainer Name="CharacterSetupPanel"
                        Visible="False"
                        StyleClasses="AngleRect"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
            <PanelContainer Name="CharacterSetupState"
                            Access="Public"
                            HorizontalExpand="True"
                            VerticalExpand="True" />
        </PanelContainer>

        <!-- Right-side chat -->
        <PanelContainer Name="ChatPanel"
                        Access="Public"
                        StyleClasses="AngleRect"
                        Visible="False"
                        MinWidth="465"
                        MinHeight="255">
            <BoxContainer Orientation="Vertical">
                <BoxContainer Orientation="Horizontal" Margin="4">
                    <Label Text="{Loc 'ui-lobby-chat-button'}"
                           StyleClasses="LabelHeading"
                           HorizontalExpand="True"
                           VerticalAlignment="Center" />
                    <Button Name="ChatCollapseButton" Text="{Loc 'ui-lobby-chat-collapse-button'}" />
                </BoxContainer>
                <widgets:ChatBox Name="Chat"
                                 Access="Public"
                                 VerticalExpand="True"
                                 Margin="3"
                                 MinHeight="50" />
            </BoxContainer>
        </PanelContainer>

        <PanelContainer Name="ChatCollapsedPanel"
                        StyleClasses="AngleRect"
                        Visible="True">
            <Button Name="ChatExpandButton" Text="{Loc 'ui-lobby-chat-button'}" />
        </PanelContainer>
    </LayoutContainer>
</lobbyUi:LobbyGui>
