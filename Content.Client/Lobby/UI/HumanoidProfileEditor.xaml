<BoxContainer xmlns="https://spacestation14.io"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:humanoid="clr-namespace:Content.Client.Humanoid"
              xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
              HorizontalExpand="True"
              VerticalExpand="True">
    <BoxContainer Orientation="Vertical" Margin="10" HorizontalExpand="True" VerticalExpand="True">
        <!-- Header: name, save state and the primary actions -->
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                <Label Text="{Loc 'humanoid-profile-editor-name-label'}" VerticalAlignment="Center" />
                <LineEdit Name="NameEdit" MinSize="270 0" VerticalAlignment="Center" />
                <Button Name="NameRandomize" Text="{Loc 'humanoid-profile-editor-name-random-button'}" />
                <Button Name="RandomizeEverythingButton" Text="{Loc 'humanoid-profile-editor-randomize-everything-button'}" />
                <Control HorizontalExpand="True" />
                <Label Name="DirtyLabel"
                       Text="{Loc 'humanoid-profile-editor-unsaved-changes'}"
                       StyleClasses="LabelSubText"
                       VerticalAlignment="Center"
                       Visible="False" />
                <Button Name="SaveButton" Text="{Loc 'humanoid-profile-editor-save-button'}" />
                <Button Name="ResetButton" Disabled="True" Text="{Loc 'humanoid-profile-editor-reset-button'}" />
                <Button Name="MoreOptionsButton"
                        ToggleMode="True"
                        Text="..."
                        ToolTip="{Loc 'humanoid-profile-editor-more-options'}" />
            </BoxContainer>

            <BoxContainer Name="MoreOptions"
                          Orientation="Horizontal"
                          HorizontalExpand="True"
                          SeparationOverride="4"
                          Visible="False"
                          Margin="0 4 0 0">
                <Button Name="ImportButton" Text="{Loc 'humanoid-profile-editor-import-button'}" />
                <Button Name="ExportButton" Text="{Loc 'humanoid-profile-editor-export-button'}" />
                <Button Name="ExportImageButton" Text="{Loc 'humanoid-profile-editor-export-image-button'}" />
                <Button Name="OpenImagesButton" Text="{Loc 'humanoid-profile-editor-open-image-button'}" />
                <Control HorizontalExpand="True" />
            </BoxContainer>

            <RichTextLabel Name="WarningLabel"
                           HorizontalExpand="True"
                           MaxWidth="640"
                           HorizontalAlignment="Left"
                           Margin="0 4 0 0" />
        </BoxContainer>

        <Control MinHeight="8" />

        <!-- Editor + preview -->
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="10">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <TabContainer Name="TabContainer" VerticalExpand="True">
                    <BoxContainer Name="AppearanceTab" Orientation="Vertical">
                        <ScrollContainer VerticalExpand="True">
                            <BoxContainer Orientation="Vertical">
                                <Label Text="{Loc 'humanoid-profile-editor-identity-heading'}"
                                       StyleClasses="LabelHeading"
                                       Margin="10 10 10 4" />
                                <BoxContainer Margin="10" Orientation="Vertical" HorizontalExpand="True">
                                    <!-- Species -->
                                    <BoxContainer HorizontalExpand="True">
                                        <Label Text="{Loc 'humanoid-profile-editor-species-label'}" />
                                        <Control HorizontalExpand="True" />
                                        <TextureButton Name="SpeciesInfoButton" Scale="0.3 0.3"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Loc 'humanoid-profile-editor-guidebook-button-tooltip'}" />
                                        <OptionButton Name="SpeciesButton" HorizontalAlignment="Right" />
                                    </BoxContainer>
                                    <!-- Species custom name -->
                                    <BoxContainer HorizontalExpand="True" Name="CCustomSpecieName">
                                        <Label Text="{Loc 'humanoid-profile-editor-customspeciename-label'}" />
                                        <Control HorizontalExpand="True" />
                                        <LineEdit Name="CCustomSpecieNameEdit" MinSize="270 0" HorizontalAlignment="Right" />
                                    </BoxContainer>
                                    <!-- Voice Bark -->
                                    <BoxContainer HorizontalExpand="True">
                                        <Label Text="{Loc 'humanoid-profile-editor-voice-bark-label'}" />
                                        <Control HorizontalExpand="True" />
                                        <Button Name="VoiceBarkPreviewButton" Text="▶"
                                                ToolTip="{Loc 'humanoid-profile-editor-voice-bark-preview-tooltip'}"
                                                HorizontalAlignment="Right" Margin="0 0 4 0" />
                                        <OptionButton Name="VoiceBarkButton" HorizontalAlignment="Right" />
                                    </BoxContainer>
                                    <!-- Age -->
                                    <BoxContainer HorizontalExpand="True">
                                        <Label Text="{Loc 'humanoid-profile-editor-age-label'}" />
                                        <Control HorizontalExpand="True" />
                                        <LineEdit Name="AgeEdit" MinSize="50 0" HorizontalAlignment="Right" />
                                    </BoxContainer>
                                    <!-- Sex -->
                                    <BoxContainer HorizontalExpand="True">
                                        <Label Text="{Loc 'humanoid-profile-editor-sex-label'}" />
                                        <Control HorizontalExpand="True" />
                                        <OptionButton Name="SexButton" HorizontalAlignment="Right" />
                                    </BoxContainer>
                                    <!-- Pronouns -->
                                    <BoxContainer HorizontalExpand="True">
                                        <Label Text="{Loc 'humanoid-profile-editor-pronouns-label'}" />
                                        <Control HorizontalExpand="True" />
                                        <OptionButton Name="PronounsButton" HorizontalAlignment="Right" />
                                    </BoxContainer>
                                </BoxContainer>

                                <Label Text="{Loc 'humanoid-profile-editor-body-heading'}"
                                       StyleClasses="LabelHeading"
                                       Margin="10 10 10 4" />
                                <!-- Skin -->
                                <BoxContainer Margin="10" HorizontalExpand="True" Orientation="Vertical">
                                    <Label Text="{Loc 'humanoid-profile-editor-skin-color-label'}" />
                                    <Slider HorizontalExpand="True" Name="Skin" MinValue="0" MaxValue="100" Value="20" />
                                    <BoxContainer Name="RgbSkinColorContainer" Visible="False" Orientation="Vertical" HorizontalExpand="True" />
                                </BoxContainer>

                                <Label Text="{Loc 'humanoid-profile-editor-hair-eyes-heading'}"
                                       StyleClasses="LabelHeading"
                                       Margin="10 10 10 4" />
                                <!-- Hair -->
                                <BoxContainer Margin="10" Orientation="Horizontal">
                                    <humanoid:SingleMarkingPicker Name="HairStylePicker" Category="Hair" />
                                    <humanoid:SingleMarkingPicker Name="FacialHairPicker" Category="FacialHair" />
                                </BoxContainer>
                                <!-- Eyes -->
                                <BoxContainer Margin="10" Orientation="Vertical">
                                    <Label Text="{Loc 'humanoid-profile-editor-eyes-label'}" />
                                    <humanoid:EyeColorPicker Name="EyeColorPicker" />
                                </BoxContainer>

                                <Label Text="{Loc 'humanoid-profile-editor-preferences-heading'}"
                                       StyleClasses="LabelHeading"
                                       Margin="10 10 10 4" />
                                <!-- Spawn Priority -->
                                <BoxContainer Margin="10" HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-spawn-priority-label'}" />
                                    <Control HorizontalExpand="True" />
                                    <OptionButton Name="SpawnPriorityButton" HorizontalAlignment="Right" />
                                </BoxContainer>
                            </BoxContainer>
                        </ScrollContainer>
                    </BoxContainer>
                    <BoxContainer Name="JobsTab" Orientation="Vertical">
                        <!-- Jobs -->
                        <OptionButton Name="PreferenceUnavailableButton" />
                        <ScrollContainer VerticalExpand="True">
                            <BoxContainer Name="JobList" Orientation="Vertical" />
                        </ScrollContainer>
                    </BoxContainer>
                    <!-- Frontier: no Antags tab
                    <BoxContainer Orientation="Vertical" Margin="10">
                        <! - - Antags  - - >
                        <ScrollContainer VerticalExpand="True">
                            <BoxContainer Name="AntagList" Orientation="Vertical" />
                        </ScrollContainer>
                    </BoxContainer>
                    End Frontier -->
                    <BoxContainer Name="TraitsTab" Orientation="Vertical" Margin="10">
                        <!-- Traits -->
                        <LineEdit Name="TraitsSearch"
                                  PlaceHolder="{Loc 'humanoid-profile-editor-traits-search'}"
                                  HorizontalExpand="True" />
                        <Label Name="TraitsSummary"
                               StyleClasses="LabelSubText"
                               Margin="0 2 0 4" />
                        <ScrollContainer VerticalExpand="True">
                            <BoxContainer Name="TraitsList" Orientation="Vertical" />
                        </ScrollContainer>
                    </BoxContainer>
                    <BoxContainer Name="MarkingsTab" Orientation="Vertical" Margin="10">
                        <!-- Markings -->
                        <ScrollContainer VerticalExpand="True">
                            <humanoid:MarkingPicker Name="Markings" IgnoreCategories="Hair,FacialHair,Genital" />
                        </ScrollContainer>
                    </BoxContainer>
                </TabContainer>
            </BoxContainer>

            <!-- Preview -->
            <BoxContainer Orientation="Vertical" VerticalExpand="True" MinWidth="320" HorizontalAlignment="Right">
                <PanelContainer Name="PreviewFrame"
                                MinSize="320 380"
                                MaxSize="320 380"
                                HorizontalAlignment="Center">
                    <TextureRect Name="PreviewTile"
                                 Stretch="KeepCentered"
                                 TextureScale="5 5"
                                 CanShrink="False"
                                 Visible="False" />
                    <SpriteView Name="SpriteView"
                                Scale="5 5"
                                Stretch="None" />
                </PanelContainer>
                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5">
                    <Button Name="SpriteRotateLeft" Text="◀" StyleClasses="OpenRight" />
                    <cc:VSeparator Margin="2 0 3 0" />
                    <Button Name="SpriteRotateRight" Text="▶" StyleClasses="OpenLeft" />
                </BoxContainer>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2" Margin="0 0 0 4">
                    <Label Text="{Loc 'humanoid-profile-editor-preview-background'}" />
                    <OptionButton Name="PreviewBackgroundButton" HorizontalExpand="True" />
                </BoxContainer>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                    <Label Name="PreviewZoomLabel" Text="{Loc 'humanoid-profile-editor-preview-zoom'}" />
                    <Slider Name="PreviewZoom"
                            HorizontalExpand="True"
                            MinValue="3"
                            MaxValue="10"
                            Value="5"
                            Rounded="False" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</BoxContainer>
